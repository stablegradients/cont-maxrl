diff --git a/src/base/loader/elf_object.cc b/src/base/loader/elf_object.cc
index 49fbd6dd7b..661efdcc5e 100644
--- a/src/base/loader/elf_object.cc
+++ b/src/base/loader/elf_object.cc
@@ -129,10 +129,19 @@ ElfObject::ElfObject(ImageFileDataPtr ifd) : ObjectFile(ifd)
         if (phdr.p_type == PT_INTERP) {
             // Make sure the interpreter is an valid ELF file.
             auto interp_path = getInterpPath(phdr);
-            ObjectFile *obj = createObjectFile(interp_path);
-            interpreter = dynamic_cast<ElfObject *>(obj);
-            assert(interpreter != nullptr);
-            _symtab.insert(obj->symtab());
+            // On a cross-rootfs SE run (x86 libs under an aarch64 host), an
+            // object's PT_INTERP may reference a guest path (e.g.
+            // /lib64/ld-linux-x86-64.so.2) that does not resolve on the host
+            // filesystem. Loading it here only contributes the interpreter's
+            // symbol table; skip it when inaccessible rather than fatally
+            // panicking inside ImageFileData. The main executable's PT_INTERP
+            // is a host-resolvable path, so it still loads normally.
+            if (access(interp_path.c_str(), R_OK) == 0) {
+                ObjectFile *obj = createObjectFile(interp_path);
+                interpreter = dynamic_cast<ElfObject *>(obj);
+                assert(interpreter != nullptr);
+                _symtab.insert(obj->symtab());
+            }
         }
     }
 
diff --git a/src/sim/syscall_emul.hh b/src/sim/syscall_emul.hh
index 05a29f9feb..ae2685b941 100644
--- a/src/sim/syscall_emul.hh
+++ b/src/sim/syscall_emul.hh
@@ -1698,14 +1698,24 @@ mmapFunc(SyscallDesc *desc, ThreadContext *tc,
         if (p->interpImage.contains(tc->pcState().instAddr())) {
             std::shared_ptr<FDEntry> fdep = (*p->fds)[tgt_fd];
             auto ffdp = std::dynamic_pointer_cast<FileFDEntry>(fdep);
-            auto *lib = Loader::createObjectFile(p->checkPathRedirect(
-                    ffdp->getFileName()));
-            DPRINTF_SYSCALL(Verbose, "Loading symbols from %s\n",
-                ffdp->getFileName());
-
-            if (lib) {
-                Addr offset = lib->buildImage().minAddr() + start;
-                Loader::debugSymbolTable.insert(*lib->symtab().offset(offset));
+            std::string lib_path =
+                p->checkPathRedirect(ffdp->getFileName());
+            // This block only populates gem5's DEBUG symbol table (used for
+            // backtraces/tracing) -- it has NO effect on simulation or timing.
+            // On a cross-rootfs SE run (x86 libs under an aarch64 host), a
+            // mmap'd path may not resolve on the host filesystem; guard with
+            // access() so a missing file is skipped instead of fatally
+            // panicking inside ImageFileData (createObjectFile).
+            if (access(lib_path.c_str(), R_OK) == 0) {
+                auto *lib = Loader::createObjectFile(lib_path);
+                DPRINTF_SYSCALL(Verbose, "Loading symbols from %s\n",
+                    ffdp->getFileName());
+
+                if (lib) {
+                    Addr offset = lib->buildImage().minAddr() + start;
+                    Loader::debugSymbolTable.insert(
+                            *lib->symtab().offset(offset));
+                }
             }
         }
     }
diff --git a/src/sim/vma.cc b/src/sim/vma.cc
index 6f6306c6b8..d34fa3bcca 100644
--- a/src/sim/vma.cc
+++ b/src/sim/vma.cc
@@ -30,6 +30,9 @@
 
 #include <sys/mman.h>
 #include <sys/stat.h>
+#include <unistd.h>
+
+#include <cstdlib>
 
 #include "base/types.hh"
 #include "config/the_isa.hh"
@@ -132,24 +135,41 @@ VMA::MappedFileBuffer::MappedFileBuffer(int fd, size_t length,
              "Tried to mmap with offset greater than file size");
     _length = std::min((size_t)(file_stat.st_size - offset), _length);
 
-    // cannot call mmap with _length == 0
+    // cannot allocate with _length == 0
     if (_length) {
-        _buffer = mmap(NULL, _length, PROT_READ,
-                                 MAP_PRIVATE, fd, offset);
-        if (_buffer == MAP_FAILED) {
-            panic("Failed to map file into host address space: %s",
-                  strerror(errno));
+        // Upstream gem5 mmap()s the file at `offset`, but mmap() requires the
+        // offset to be a multiple of the HOST page size. On big-page hosts
+        // (e.g. 64 KB-page Arm/Grace), x86 ELF library segments have 4 KB-
+        // aligned offsets and trip mmap() with EINVAL. This buffer is only
+        // ever read (copied into target memory by fillMemPages), so use a
+        // heap buffer filled via pread() instead -- no alignment requirement,
+        // semantically identical to the read-only private mapping. calloc()
+        // zero-fills so any short read (e.g. .bss tail) is already zeroed.
+        _buffer = calloc(1, _length);
+        if (!_buffer) {
+            panic("Failed to allocate %llu-byte host buffer for file mapping",
+                  (unsigned long long)_length);
+        }
+        size_t done = 0;
+        while (done < _length) {
+            ssize_t n = pread(fd, (char *)_buffer + done,
+                              _length - done, offset + done);
+            if (n < 0) {
+                panic("Failed to pread file into host address space: %s",
+                      strerror(errno));
+            }
+            if (n == 0)
+                break;  // EOF; remainder already zeroed by calloc
+            done += n;
         }
     } else {
-        panic("Tried to mmap 0 bytes");
+        panic("Tried to map 0 bytes");
     }
 }
 
 VMA::MappedFileBuffer::~MappedFileBuffer()
 {
     if (_buffer) {
-        panic_if(munmap(_buffer, _length) == -1,
-                 "mmap: failed to unmap file-backed host memory: %s",
-                 strerror(errno));
+        free(_buffer);
     }
 }
